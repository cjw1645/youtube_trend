YOUTUBE_API_KEY=
GEMINI_API_KEY=

# Supabase (서버 전용 값은 VITE_ 접두사를 붙이지 않는다)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 브라우저 번들에 포함되는 공개 값(anon key는 공개용 키). service role 키는 절대 넣지 않는다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 공통 수집(서버 전용). Supabase Cron이 이 값을 Bearer로 보낸다. 32자 이상 무작위 값.
COLLECT_SECRET=
# 선택: 하루 YouTube 호출 상한(기본 1000)
YOUTUBE_DAILY_UNIT_CAP=
# 선택: 서비스 전체 하루 개인 검색(search.list) 호출 상한(기본 80). 사용자별 하루 40회는 DB 함수 기본값.
SEARCH_DAILY_CAP=

# 선택: 로그인 없는 공개 조회(인기 차트·영상 상세·카테고리)의 서비스 전체 하루 YouTube 유닛 상한(기본 500). CDN 캐시에 걸린 응답은 소비하지 않는다.
PUBLIC_YOUTUBE_DAILY_UNIT_CAP=

# 선택: 서비스 전체 하루 AI 요청 수(기본 40)와 토큰 수(기본 1,000,000). 사용자별 하루 10회·30초 간격은 DB 함수 기본값.
AI_DAILY_CAP=
AI_DAILY_TOKEN_CAP=
