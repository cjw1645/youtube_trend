{
  "functions": {
    "api/collect.ts": {
      "maxDuration": 60
    },
    "api/search-slots.ts": {
      "maxDuration": 60
    },
    "api/chat.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/snapshot",
      "destination": "/api/stored?kind=snapshot"
    },
    {
      "source": "/api/trend",
      "destination": "/api/stored?kind=trend"
    },
    {
      "source": "/api/search-snapshot",
      "destination": "/api/search-data?kind=snapshot"
    },
    {
      "source": "/api/search-trend",
      "destination": "/api/search-data?kind=trend"
    },
    {
      "source": "/api/collect-search",
      "destination": "/api/collect?job=search"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net data:; img-src 'self' data: https://i.ytimg.com https://yt3.ggpht.com https://yt3.googleusercontent.com; connect-src 'self' https://*.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ]
}
