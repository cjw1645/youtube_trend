{
  "permissions": {
    "allow": ["Bash(npm install *)", "Bash(npm run *)", "Bash(npx tsc *)", "Bash(vercel dev *)",
              "Bash(git status *)", "Bash(git diff *)", "Bash(git log *)", "Bash(git add *)", "Bash(git commit *)"],
    "ask":   ["Bash(git push *)", "Bash(vercel --prod *)", "Bash(vercel env *)"],
    "deny":  ["Read(./.env.local)", "Read(./.env)", "Read(./.env.*.local)",
              "Bash(*.env.local*)", "Bash(cat .env)", "Bash(type .env)",
              "PowerShell(*.env.local*)", "PowerShell(Get-Content .env)"]
  }
}
